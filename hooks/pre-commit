#!/bin/sh
# devkit-pre-commit — installed by `sh scripts/install-hooks.sh`, never automatically.
# Runs the full suite (node, no dependencies, well under a second), which includes the three
# workflow `dryRun` smoke calls. Bypass once with `git commit --no-verify`.
#
# It deliberately tests the WORKING TREE, not the staged snapshot. A stash-and-restore dance is the
# usual refinement and it is the wrong trade here: it can lose work when it goes wrong, and the
# failure it would catch (a commit that passes staged but not whole) is one `scripts/promote-plugin.sh`
# catches anyway, since it refuses to promote a dirty tree or a failing suite.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# git exports GIT_DIR (and friends) into every hook, and those variables BEAT `cwd` when git picks a
# repository. The suite shells out to git in throwaway directories, so leaving them set points those
# commands at the repository being committed to instead: reproduced, a `git init` in a temp dir
# re-inited the real repo through the inherited GIT_DIR and left it `core.bare = true`, which breaks
# every later `git status` in that checkout. It bites hardest under `/dev-implement --isolated`,
# whose phase commit runs in a worktree, but the variables are exported for an ordinary commit too.
# Unset here so the suite sees the same environment a developer running it by hand does — the tests
# scrub their own child environments as well, and this is the half that also covers a test nobody
# has written yet.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_NAMESPACE

command -v node >/dev/null 2>&1 || {
  echo "pre-commit: node not found — skipping the suite (it is what verifies this repo)" >&2
  exit 0
}

if ! sh tests/run-all.sh; then
  echo >&2
  echo "pre-commit: suite failed — commit aborted." >&2
  echo "fix it, or bypass deliberately with: git commit --no-verify" >&2
  exit 1
fi
